# Copy to .env and fill in. All secrets stay server-side; nothing here reaches the frontend.

# --- Infrastructure (docker compose defaults) ---
DATABASE_URL=postgresql+asyncpg://geo:geo@postgres:5432/geo
REDIS_URL=redis://redis:6379/0
# Session cookies are only sent over HTTPS when true. Use false only for local http:// testing.
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=480

# --- OpenAI: used ONLY to repair messy inputs, suggest column mappings and pick between
# geocoder candidates. It never produces coordinates. Leave empty to run without AI repair.
# ── AI assistant: Siemens Healthineers OpenAI gateway ──────────────────
OPENAI_BASE_URL=https://apimgateway.siemens-healthineers.com/openai
OPENAI_API_VERSION=2024-02-01
OPENAI_CHAT_DEPLOYMENT=gpt-5.1             # deployment/model name, e.g. gpt-4o
OPENAI_EMBEDDING_DEPLOYMENT=         # optional; leave empty to disable semantic search
OPENAI_API_KEY=
OPENAI_AUTH_STYLE=api-key            # api-key | bearer | subscription-key  ← PROBE, DO NOT ASSUME
OPENAI_TIMEOUT_S=30
# Optional tuning:
# OPENAI_CONCURRENCY=4               # parallel repair requests per worker (each carries 25 addresses)
# OPENAI_RPM=300                     # request rate limit shared by all workers
# OPENAI_BATCH_ENABLED=              # Batch API: default on for api.openai.com, off for gateways (/files, /batches return 404)
# OPENAI_MODEL=gpt-5-mini            # used only when OPENAI_CHAT_DEPLOYMENT is empty (plain api.openai.com)
AI_BATCH_THRESHOLD=2000
AI_ADDRESSES_PER_REQUEST=25

# --- External geocoder for street-level rows and offline misses ---
GEOCODER_PROVIDER=opencage
GEOCODER_API_KEY=
GEOCODER_RPS=1
GEOCODE_CACHE_TTL_DAYS=365
POSTCODE_MISMATCH_KM=25

# --- Limits ---
MAX_UPLOAD_MB=100
MAX_ROWS=250000
CHUNK_SIZE=500
FILE_RETENTION_DAYS=30

CORS_ORIGINS=["http://localhost:5173"]
